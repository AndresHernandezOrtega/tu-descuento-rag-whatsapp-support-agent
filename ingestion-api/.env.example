# API Settings
APP_NAME=Ingestion API
APP_VERSION=1.0.0
DEBUG=False

# ChromaDB Settings
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=documents

# Embedding Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# CORS Settings (comma separated origins)
CORS_ORIGINS=*
